{
  "manifest_version": 3,
  "name": "AgeGate Demo",
  "version": "0.1",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://localhost:3000/restricted*"], "js": ["content.js"] }]
}
