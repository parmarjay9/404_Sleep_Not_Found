# Copy your Supabase project URL and publishable key from the dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# Keep blank unless enabling provider-verified profile writes.
# Never put this value in frontend code or commit a real value.
SUPABASE_SERVICE_KEY=

# Local app settings.
VERIFICATION_PROVIDER=none
PORT=3000
SITE_URL=http://localhost:3000
ADMIN_TOKEN=replace-with-a-long-random-local-token

# Optional demo-only setting. Never enables real verification.
DEMO_VERIFICATION=false
NODE_ENV=development
